<?xml version="1.0" encoding="utf-8"?>
<!-- Le serveur Laststream tourne sur le PC de l'utilisateur, en http sur le réseau local.
     Android ne sait pas exprimer des plages d'adresses (10.x, 172.16-31.x, 192.168.x) ici : le http est donc autorisé,
     et l'application le limite aux adresses privées, .local et localhost (voir src/data/lan.ts). Le reste passe en https. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
