{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "laststream-www",
  // Worker Previews (Workers Builds, branches hors main) : bloc requis par `wrangler preview`. Vide = aucune liaison de production héritée.
  "previews": {},
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  // Worker edge (renommé « laststream-edge » dans Cloudflare) : relais /api/*.
  "services": [{ "binding": "APP", "service": "laststream-edge" }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // "/*" : le Worker doit voir toutes les requêtes, sinon les statiques servis avant lui court-circuitent la redirection 301 de www.
    "run_worker_first": ["/*"]
  }
}
