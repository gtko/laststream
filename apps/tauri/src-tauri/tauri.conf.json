{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Laststream",
  "identifier": "app.laststream.desktop",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis"
    ],
    "category": "Entertainment",
    "shortDescription": "Laststream - Freedom to Stream",
    "copyright": "Laststream",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French",
          "English"
        ]
      }
    }
  }
}
