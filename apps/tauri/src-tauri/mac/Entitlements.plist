<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Droits de l'app macOS signée Developer ID (runtime renforcé, obligatoire pour la notarisation). Utilisé seulement quand
  la release signe avec un vrai certificat (tauri-release.yml) ; la build ad hoc n'en a pas besoin.
  - allow-jit, allow-unsigned-executable-memory : libmpv (Homebrew) embarque LuaJIT et des décodeurs qui génèrent du code ;
  - disable-library-validation : bibliothèques de Contents/Frameworks copiées depuis Homebrew (dylibbundler). Tauri les
    re-signe avec le même certificat, ce droit évite un refus de chargement si l'une d'elles y échappait.
  À réduire une fois la lecture vérifiée sur un Mac avec l'app notarisée.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
