{
  "name": "lastaddon",
  "version": "0.4.3",
  "description": "Addon Stremio agrégateur de streams pour Laststream",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "gtko",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc-app.tsbuildinfo -p tsconfig.json && tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc-test.tsbuildinfo -p tsconfig.test.json",
    "test": "vitest run",
    "test:workers": "vitest run -c vitest.workers.config.ts",
    "deploy:worker": "node scripts/deploy-worker.mjs",
    "release": "node scripts/release.mjs",
    "tv:live": "tsx scripts/tv-live-check.ts",
    "tv:health": "tsx scripts/tv-health-check.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ .",
    "knip": "knip",
    "bundle": "node scripts/bundle.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@laststream/protocol": "github:gtko/laststream-protocol#v0.5.0",
    "@sentry/cloudflare": "^11.4.0",
    "hono": "^4.13.13",
    "undici": "^7.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@cloudflare/workers-types": "^5.20261018.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "knip": "6.41.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
