{
  // Worker Cloudflare « lastaddon-core » : même application Hono que le serveur Node (src/worker.ts), plateforme Workers.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lastaddon-core",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  // Plan payant : jusqu'à 30 s de CPU par requête (scrypt ≈ 72 ms à la connexion, analyse des sources).
  "limits": { "cpu_ms": 30000 },
  "observability": { "enabled": true },

  // Données utilisateur : un Durable Object SQLite global nommé « users » (voir src/platform/workers/user-store-do.ts).
  "durable_objects": {
    "bindings": [
      { "name": "USER_STORE", "class_name": "UserStoreDO" },
      // Salons de visionnage : un Durable Object par salon (WebSocket, API d'hibernation), voir src/platform/workers/party-room.ts.
      { "name": "PARTY_ROOM", "class_name": "PartyRoom" },
      // Métriques d'exploitation (tranches de 5 min, 7 jours) et purges de cache asynchrones, voir src/platform/workers/metrics-do.ts.
      { "name": "METRICS", "class_name": "Metrics" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["UserStoreDO"] },
    { "tag": "v2", "new_sqlite_classes": ["PartyRoom"] },
    { "tag": "v3", "new_sqlite_classes": ["Metrics"] }
  ],

  // Caches persistants partagés entre instances : statut AllDebrid, packs, URL émises, torrents privés, hébergeurs.
  "kv_namespaces": [{ "binding": "CACHE", "id": "ec421766c5b74c5cac6f3cd76d4f7adf" }],

  // Limites de connexion/inscription (binding Rate Limiting, partagé par emplacement). La période ne peut valoir que 10 ou 60 s :
  // 10 tentatives par minute et par IP (AUTH_LIMITER_IP) et par nom d'utilisateur (AUTH_LIMITER_USER).
  "ratelimits": [
    { "name": "AUTH_LIMITER_IP", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "AUTH_LIMITER_USER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    // Signature de liens débridés directs (POST /lt/range-source) : 20 par minute et par configuration.
    { "name": "RANGE_LIMITER", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
    // Appels sortants vers MDBList (clé partagée, quota quotidien) : 20 par minute au total, quel que soit le compte.
    { "name": "MDBLIST_LIMITER", "namespace_id": "1004", "simple": { "limit": 20, "period": 60 } }
  ],

  // TV en direct : le catalogue des chaînes et l'EPG réduit (maintenant → +24 h) sont construits hors requête, en flux
  // (sous 128 Mo), par le Cron Trigger ci-dessous, et écrits dans R2 ; les routes /lt/tv/* les lisent.
  // Bucket à créer une fois : npx wrangler r2 bucket create lastaddon-tv
  "r2_buckets": [
    { "binding": "TV", "bucket_name": "lastaddon-tv" },
    // Fiches partagées (TMDB + TVDB + notes + casting + épisodes) : meta/<type>/<tmdbId>.json, voir src/lt/meta.ts.
    // Bucket à créer une fois : npx wrangler r2 bucket create lastaddon-meta
    { "binding": "META", "bucket_name": "lastaddon-meta" },
    // Avatars par collections (catalog.json, c/, i/) : envoyés par scripts/avatars/upload.mjs, servis sur /avatars/*.
    // Bucket à créer une fois : npx wrangler r2 bucket create lastaddon-avatars
    { "binding": "AVATARS", "bucket_name": "lastaddon-avatars" }
  ],
  "triggers": { "crons": ["0 */6 * * *"] },

  // Interface web : build de laststream-app copié dans worker-ui/ par `npm run deploy:worker`.
  // Le Worker passe en premier (en-têtes de cache, routes API) ; html_handling « none » garde les chemins exacts.
  "assets": {
    "directory": "./worker-ui",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },

  "vars": {
    // Mode public : adresses privées refusées pour les URL saisies (SSRF) ; la base publique sert aux liens /play.
    // AllDebrid suspend les comptes appelés depuis des IP de serveurs : aucun appel AllDebrid depuis Cloudflare.
    "LASTADDON_DEBRID_SERVER_SIDE": "0",
    "LASTADDON_PUBLIC": "1",
    "LASTADDON_PUBLIC_URL": "https://lastaddon-core.gtux-prog.workers.dev",
    // Plus de relais de plages (LASTADDON_RANGE_BASE retiré) : l'appareil lit les miniatures directement chez l'hébergeur
    // débridé, avec son IP, comme la lecture. Aucune requête vers AllDebrid ni ses hôtes ne part de Cloudflare.
    // Origines autorisées pour /config, /user et les écritures lt (en plus de l'origine du Worker).
    "LASTADDON_ALLOWED_ORIGINS": "https://lastaddon-core.gtux-prog.workers.dev,https://laststream.gtux-prog.workers.dev,https://localhost,http://localhost,capacitor://localhost"
  }
  // Secrets (wrangler secret put, jamais dans ce fichier) : LASTADDON_SECRET, RANGE_SECRET, EDGE_SECRET,
  // ADMIN_SECRET (route /__admin/ de migration des données ; `wrangler secret delete ADMIN_SECRET` la ferme),
  // et LASTADDON_BOOTSTRAP_TOKEN si le premier compte doit être protégé. SENTRY_DSN : remontée des erreurs (absent = aucune).
}
