# Copier ce fichier en .env et adapter les valeurs.
# .env ne doit jamais être commité (déjà dans .gitignore).

# Clé de chiffrement des configurations (AES-256-GCM). 32 caractères minimum.
# Laisser vide : une valeur aléatoire est générée automatiquement dans .env au premier démarrage.
LASTADDON_SECRET=

# Accepter les configurations en JSON brut (base64url, non chiffré). 1 = oui, 0 = non (défaut).
# Déconseillé en production : la config contient les clés API des sources.
LASTADDON_ALLOW_PLAIN=0

# Port d'écoute HTTP (défaut 7000).
PORT=7000

# Mode public : 1 = URL des sources limitées aux adresses publiques (anti-SSRF). Exige LASTADDON_PUBLIC_URL.
# LASTADDON_PUBLIC=0

# Derrière un reverse proxy de confiance : 1 = utiliser X-Forwarded-Proto et X-Forwarded-Host.
# LASTADDON_TRUST_PROXY=0

# Origines autorisées en CORS sur /config/* (liste séparée par des virgules).
# LASTADDON_ALLOWED_ORIGINS=http://localhost:8089,http://localhost:8080

# Données utilisateur (/user/*) : base SQLite data/laststream.db. Chemin relatif à la racine du projet.
# LASTADDON_DATA_DIR=./data

# Inscription ouverte sur /user/register. 1 = oui. Sinon seul le premier compte peut être créé.
# LASTADDON_ALLOW_SIGNUP=0

# Premier compte (/user/register) : si défini, exige l'en-tête X-Bootstrap-Token avec cette valeur.
# Absent : le premier compte créé devient propriétaire (risque si le serveur est exposé).
# LASTADDON_BOOTSTRAP_TOKEN=

# Prowlarr local : sans source configurée, le serveur interroge un Prowlarr installé sur cette machine.
# 0 = désactivé. En mode public (LASTADDON_PUBLIC=1), il faut LASTADDON_PROWLARR_AUTO=1 explicitement.
# LASTADDON_PROWLARR_AUTO=1

# Base du Prowlarr local (défaut http://localhost:9696).
# LASTADDON_PROWLARR_URL=http://localhost:9696

# Clé API du Prowlarr local. Absente : lue dans le config.xml de Prowlarr (balise ApiKey).
# Ne jamais commiter une valeur réelle.
# LASTADDON_PROWLARR_KEY=

# Chemin du config.xml de Prowlarr (défaut : C:\ProgramData\Prowlarr\config.xml sous Windows, ~/.config/Prowlarr/config.xml sous Linux).
# LASTADDON_PROWLARR_CONFIG_PATH=
