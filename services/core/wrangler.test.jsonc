{
  // Configuration des tests Workers (vitest.workers.config.ts) : même Worker, ressources locales simulées par Miniflare.
  "name": "lastaddon-core-test",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "USER_STORE", "class_name": "UserStoreDO" },
      { "name": "PARTY_ROOM", "class_name": "PartyRoom" },
      { "name": "METRICS", "class_name": "Metrics" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["UserStoreDO"] },
    { "tag": "v2", "new_sqlite_classes": ["PartyRoom"] },
    { "tag": "v3", "new_sqlite_classes": ["Metrics"] }
  ],
  "kv_namespaces": [{ "binding": "CACHE" }],
  "r2_buckets": [
    { "binding": "TV", "bucket_name": "lastaddon-tv-test" },
    { "binding": "META", "bucket_name": "lastaddon-meta-test" }
  ],
  "assets": { "directory": "./tests-workers/ui", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  "ratelimits": [
    { "name": "AUTH_LIMITER_IP", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "AUTH_LIMITER_USER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  "vars": {
    // Valeurs de test, jamais des secrets réels.
    "LASTADDON_SECRET": "lt-test-secret-with-more-than-32-chars",
    "RANGE_SECRET": "range-test-secret-0123456789",
    "ADMIN_SECRET": "admin-test-secret-with-more-than-32-chars",
    "LASTADDON_PUBLIC": "1",
    "LASTADDON_PUBLIC_URL": "https://lastaddon-test.example.com",
    "LASTADDON_RANGE_BASE": "https://relay.example.com"
  }
}
