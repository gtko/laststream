{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "laststream",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  // Secret optionnel, hors de ce fichier : SENTRY_DSN (wrangler secret put SENTRY_DSN) remonte les appels sortants refusés par la garde.
  // Application : Worker « lastaddon-core » appelé par Service Binding (toutes les routes).
  "services": [{ "binding": "CORE", "service": "lastaddon-core" }],
  "vars": {
    // Repli vers le tunnel du PC si core renvoie 5xx ET qu'un tunnel est enregistré. « 0 » le désactive (puis wrangler deploy).
    "TUNNEL_FALLBACK": "1"
  },
  // APK Android publiés (mise à jour en un tap) : /app/android/<fichier>.apk.
  "r2_buckets": [{ "binding": "APP_FILES", "bucket_name": "laststream-app-files" }],
  "kv_namespaces": [
    { "binding": "LASTSTREAM_ROUTE", "id": "7b2471b0347c4620b96b2d54a6142ed0" }
  ]
}
